# ============================================================
# LifeQuest — Environment Variables
# Скопируй этот файл в .env и заполни реальными значениями
# ============================================================

# --- База данных PostgreSQL ---
POSTGRES_USER=lifequest_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=lifequest_db

# URL для SQLAlchemy (asyncpg). Хост = имя контейнера db
DATABASE_URL=postgresql+asyncpg://lifequest_user:CHANGE_ME_strong_password@db:5432/lifequest_db

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- JWT Авторизация ---
SECRET_KEY=CHANGE_ME_generate_random_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- YandexGPT (ИИ-оценка Effort Score) ---
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# --- AI defaults ---
AI_TIMEOUT_SECONDS=10
AI_DEFAULT_EFFORT_SCORE=5
AI_DEFAULT_COMPLEXITY=Medium
AI_DEFAULT_REASONING=Оценка по умолчанию (таймаут ИИ)
