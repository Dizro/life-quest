# База данных PostgreSQL
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=your_db_name_here

# URL для подключения SQLAlchemy 
DATABASE_URL=postgresql+asyncpg://your_db_user_here:your_secure_password_here@db:5432/your_db_name_here

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# JWT Авторизация 
SECRET_KEY=super-secret-key-change-it-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# YandexGPT (ИИ-оценка Effort Score, §7.1)
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here